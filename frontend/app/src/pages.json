{
  "globalStyle": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "FastAPI Admin Starter",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "backgroundColorTop": "@bgColorTop",
    "backgroundColorBottom": "@bgColorBottom",
    "enablePullDownRefresh": false,
    "onReachBottomDistance": 50,
    "animationType": "pop-in",
    "animationDuration": 300
  },
  "pages": [
    // #ifdef APP || H5
    {
      "path": "pages/index/index",
      "type": "home",
      "name": "home",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    // #endif
    // #ifdef MP-WEIXIN
    {
      "path": "pages/index/index",
      "type": "home",
      "name": "home",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    // #endif
    {
      "path": "pages/error/index",
      "type": "page",
      "name": "not-found",
      "layout": "default",
      "style": {
        "navigationBarTitleText": "页面不存在"
      }
    },
    {
      "path": "pages/login/index",
      "type": "page",
      "name": "login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/mall/index",
      "type": "page",
      "name": "mall",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "商城"
      }
    },
    {
      "path": "pages/mine/index",
      "type": "page",
      "name": "mine",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/login/forget/index",
      "type": "page",
      "name": "forget",
      "style": {
        "navigationBarTitleText": "忘记密码"
      }
    },
    {
      "path": "pages/login/register/index",
      "type": "page",
      "name": "register",
      "style": {
        "navigationBarTitleText": "注册"
      }
    }
  ],
  "subPackages": [
    {
      "root": "subPages",
      "pages": [
        // #ifdef APP || H5 || MP-WEIXIN
        {
          "path": "about/index",
          "type": "page",
          "name": "about",
          "style": {
            "navigationBarTitleText": "关于"
          }
        },
        // #endif
        // #ifdef APP || H5 || MP-WEIXIN
        {
          "path": "setting/index",
          "type": "page",
          "name": "setting",
          "layout": "default",
          "style": {
            "navigationBarTitleText": "设置"
          }
        },
        // #endif
        // #ifdef APP || H5 || MP-WEIXIN
        {
          "path": "module_system/profile/index",
          "type": "page",
          "name": "profile",
          "layout": "default",
          "style": {
            "navigationBarTitleText": "个人资料"
          }
        },
        // #endif
        // #ifdef APP || H5 || MP-WEIXIN
        {
          "path": "module_system/account/index",
          "type": "page",
          "name": "account",
          "layout": "default",
          "style": {
            "navigationBarTitleText": "安全设置"
          }
        },
        // #endif
        {
          "path": "module_app/address/form",
          "type": "page",
          "name": "address-form",
          "style": {
            "navigationBarTitleText": "地址"
          }
        },
        {
          "path": "module_app/address/index",
          "type": "page",
          "name": "addresses",
          "style": {
            "navigationBarTitleText": "我的地址"
          }
        },
        {
          "path": "module_app/bank-account/form",
          "type": "page",
          "name": "bank-account-form",
          "style": {
            "navigationBarTitleText": "银行卡"
          }
        },
        {
          "path": "module_app/bank-account/index",
          "type": "page",
          "name": "bank-accounts",
          "style": {
            "navigationBarTitleText": "我的银行卡"
          }
        },
        {
          "path": "module_app/order/detail",
          "type": "page",
          "name": "order-detail",
          "style": {
            "navigationBarTitleText": "订单详情"
          }
        },
        {
          "path": "module_app/order/index",
          "type": "page",
          "name": "orders",
          "style": {
            "navigationBarTitleText": "我的订单"
          }
        },
        {
          "path": "module_product/product-detail/index",
          "type": "page",
          "name": "product-detail",
          "style": {
            "navigationBarTitleText": "商品详情"
          }
        },
        {
          "path": "module_system/kyc/index",
          "type": "page",
          "name": "kyc",
          "style": {
            "navigationBarTitleText": "实名认证"
          }
        },
        {
          "path": "module_system/notices/index",
          "type": "page",
          "name": "notices",
          "style": {
            "navigationBarTitleText": "通知公告",
            "enablePullDownRefresh": true
          }
        }
      ]
    }
  ],
  "tabBar": {
    "custom": true,
    "height": "0",
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      // GENERATED BY UNI-PAGES, PLATFORM: H5
      {
        "pagePath": "pages/index/index"
      },
      {
        "pagePath": "pages/mall/index"
      },
      {
        "pagePath": "pages/mine/index"
      }
    ]
  }
}
