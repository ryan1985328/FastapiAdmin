# ==================================
# 环境配置文件:修改名称example为.env.dev或.env.prod
# 修改内容：ENVIRONMENT、DATABASE_PASSWORD、REDIS_PASSWORD
# ==================================

ENVIRONMENT = dev # prod

# 服务器配置
SERVER_HOST = localhost
SERVER_PORT = 8001

# 文档配置
DEBUG = True
VERSION = 3.1.0


# 数据库配置：mysql-3306、postgres-5432、sqlite
DATABASE_TYPE = mysql
DATABASE_HOST = localhost
DATABASE_PORT = 3306
DATABASE_USER = root
DATABASE_PASSWORD = your_database_password
DATABASE_NAME = fastapiadmin

# Redis配置
REDIS_HOST = localhost
REDIS_PORT = 6379
REDIS_USER = ''
REDIS_PASSWORD = your_redis_password
REDIS_DB_NAME = 1

# App 短信固定验证码（仅 dev/test 可启用，生产环境强制忽略）
APP_SMS_FIXED_CODE_ENABLED = False
APP_SMS_FIXED_CODE = 888888

# 日志级别配置
LOGGER_LEVEL = DEBUG
